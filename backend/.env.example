# Remote Excel Configuration
# OneDrive shared file example:
# EXCEL_SOURCE_URL=https://1drv.ms/x/c/...
#
# Google Drive file example:
# EXCEL_SOURCE_URL=https://drive.google.com/file/d/FILE_ID/view?usp=sharing
#
# Google Sheets example:
# EXCEL_SOURCE_URL=https://docs.google.com/spreadsheets/d/SHEET_ID/edit?usp=sharing
EXCEL_SOURCE_URL=
EXCEL_SHEET_NAME=

# OneDrive write support (Microsoft Graph)
# Required to save uploaded changes back into the OneDrive Excel file.
# Use a delegated Graph access token with Files.ReadWrite permission.
ONEDRIVE_ACCESS_TOKEN=

# Optional. If empty, the backend resolves these from EXCEL_SOURCE_URL via Graph /shares.
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ITEM_ID=

# FastAPI Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:4200
