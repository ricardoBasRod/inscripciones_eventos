# Remote Excel Configuration
# Google Drive Excel file example:
# EXCEL_SOURCE_URL=https://drive.google.com/file/d/FILE_ID/view?usp=sharing
#
# For this branch, use a real .xlsx file stored in Google Drive.
EXCEL_SOURCE_URL=
EXCEL_SHEET_NAME=

# Google Drive write support
# Recommended: create a Google Cloud service account, download its JSON key,
# and share the Excel file with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Alternative: paste a short-lived OAuth access token with Drive permissions.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Optional. If empty, backend extracts file id from EXCEL_SOURCE_URL.
GOOGLE_DRIVE_FILE_ID=

# Default scope permits reading/writing files shared with the service account.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive

# FastAPI Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:4200
