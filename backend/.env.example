# Remote Google Sheets Configuration
# This URL can be the normal /edit Google Sheets URL. The backend reads it
# through the public XLSX export unless GOOGLE_APPS_SCRIPT_READ=true.
EXCEL_SOURCE_URL=https://docs.google.com/spreadsheets/d/1PIQgMw0NIQ0F1vzEL8eCFENI36mKF_hcXSG49vH8Qvs/edit?usp=sharing
EXCEL_SHEET_NAME=

# Google Apps Script write support
# Paste the Web App URL generated from google-apps-script/Code.gs.
GOOGLE_APPS_SCRIPT_URL=

# Must match SECRET in google-apps-script/Code.gs.
GOOGLE_APPS_SCRIPT_SECRET=cambia-este-token

# false: read through public Google Sheets XLSX export.
# true: read through Apps Script too, useful if the sheet is not public.
GOOGLE_APPS_SCRIPT_READ=false

# FastAPI Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:4200
